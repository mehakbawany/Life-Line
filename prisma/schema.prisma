generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==========================================
// Enums
// ==========================================

enum Role {
  USER
  ADMIN
  DISPATCHER
  DISTRICT_ADMIN
  MAIN_ADMIN
}

enum AmbulanceStatus {
  AVAILABLE
  EN_ROUTE
  ON_MISSION
  RESERVED_FOR_EVENT
  SOFT_BLOCKED
  HARD_BLOCKED
}

enum RequestStatus {
  PENDING
  QUEUED
  ASSIGNED
  EN_ROUTE
  ON_SCENE
  TRANSPORTING
  COMPLETED
  CANCELLED
}

enum AssignmentStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  REJECTED
  FAILED_MID_ROUTE
  COMPLETED
}

enum EventStatus {
  CREATED
  ACTIVE
  ESCALATED
  CONTAINED
  COMPLETED
  ARCHIVED
}

enum SeverityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  NATIONAL_EMERGENCY
}

enum GlobalHealthState {
  NORMAL
  STRESSED
  CRITICAL
  OVERLOAD
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

// ==========================================
// System Infrastructure Models
// ==========================================

model SystemState {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  healthState     GlobalHealthState  @default(NORMAL)
  lastEvaluatedAt DateTime           @default(now())
}

model SystemAuditLog {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  actionType      String
  details         String?
  actorId         String?            @db.ObjectId
  timestamp       DateTime           @default(now())
}

// ==========================================
// Core Models
// ==========================================

model User {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId
  email          String?            @unique
  name           String?
  phoneNumber    String             @unique
  passwordHash   String?
  role           Role               @default(USER)
  address        String?
  trustScore     Int                @default(100)
  
  // Relations
  requests       EmergencyRequest[] @relation("UserRequests")
  payments       Payment[]          @relation("UserPayments")
  incidentReports IncidentReport[]  @relation("ReportedIncidents")

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model Driver {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId
  userId         String?            @db.ObjectId @unique
  name           String
  phoneNumber    String             @unique
  licenseNumber  String             @unique
  isAvailable    Boolean            @default(true)
  trustScore     Int                @default(100)
  
  // Relations
  ambulanceId    String?            @db.ObjectId @unique
  ambulance      Ambulance?         @relation(fields: [ambulanceId], references: [id])
  dispatchLogs   DispatchLog[]

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model Ambulance {
  id               String             @id @default(auto()) @map("_id") @db.ObjectId
  vehicleNumber    String             @unique
  type             String             // e.g., BLS, ALS
  status           AmbulanceStatus    @default(AVAILABLE)
  
  latitude         Float?
  longitude        Float?
  lastLocationUpdate DateTime?

  // Relations
  driver           Driver?
  dispatchLogs     DispatchLog[]
  dispatchAssignments DispatchAssignment[]
  eventAssignments EventAssignment[]

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model Hospital {
  id               String             @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  specialty        String
  latitude         Float
  longitude        Float
  capacity         Int
  availableBeds    Int
  
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

// ==========================================
// Operational Models
// ==========================================

model EmergencyRequest {
  id               String             @id @default(auto()) @map("_id") @db.ObjectId
  patientName      String?
  patientPhone     String?
  pickupLocation   String
  pickupLat        Float
  pickupLng        Float
  dropoffLocation  String?
  dropoffLat       Float?
  dropoffLng       Float?
  
  status           RequestStatus      @default(PENDING)
  severity         SeverityLevel      @default(MEDIUM)
  symptoms         String?

  responseDeadline DateTime?
  escalationCount  Int                @default(0)
  
  // Relations
  userId           String?            @db.ObjectId
  user             User?              @relation("UserRequests", fields: [userId], references: [id])
  
  dispatchAssignments DispatchAssignment[]
  dispatchLogs     DispatchLog[]
  payment          Payment?
  incidentReport   IncidentReport?

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model DispatchAssignment {
  id               String             @id @default(auto()) @map("_id") @db.ObjectId
  status           AssignmentStatus   @default(PENDING_ACCEPTANCE)
  rejectionReason  String?
  assignedAt       DateTime           @default(now())
  expiresAt        DateTime

  // Relations
  requestId        String             @db.ObjectId
  request          EmergencyRequest   @relation(fields: [requestId], references: [id])
  
  ambulanceId      String             @db.ObjectId
  ambulance        Ambulance          @relation(fields: [ambulanceId], references: [id])
}

// ==========================================
// Event Layer Models
// ==========================================

model Event {
  id                   String             @id @default(auto()) @map("_id") @db.ObjectId
  title                String
  description          String?
  type                 String
  location             String
  severity             SeverityLevel
  status               EventStatus        @default(CREATED)
  estimatedVictims     Int                @default(0)
  maxAmbulanceCapacity Int
  
  // Relations
  eventAssignments     EventAssignment[]
  
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model EventAssignment {
  id               String             @id @default(auto()) @map("_id") @db.ObjectId
  assignedAt       DateTime           @default(now())
  
  // Relations
  eventId          String             @db.ObjectId
  event            Event              @relation(fields: [eventId], references: [id])
  
  ambulanceId      String             @db.ObjectId
  ambulance        Ambulance          @relation(fields: [ambulanceId], references: [id])
}

// ==========================================
// Historical & Logging Models
// ==========================================

model DispatchLog {
  id                 String           @id @default(auto()) @map("_id") @db.ObjectId
  action             String
  notes              String?
  timestamp          DateTime         @default(now())
  
  latitude           Float?
  longitude          Float?

  // Relations
  requestId          String           @db.ObjectId
  request            EmergencyRequest @relation(fields: [requestId], references: [id])
  
  ambulanceId        String?          @db.ObjectId
  ambulance          Ambulance?       @relation(fields: [ambulanceId], references: [id])

  driverId           String?          @db.ObjectId
  driver             Driver?          @relation(fields: [driverId], references: [id])
}

model Payment {
  id                 String           @id @default(auto()) @map("_id") @db.ObjectId
  amount             Float
  currency           String           @default("USD")
  method             String
  status             PaymentStatus    @default(PENDING)
  transactionId      String?          @unique
  dueDate            DateTime?
  
  // Relations
  requestId          String           @db.ObjectId @unique
  request            EmergencyRequest @relation(fields: [requestId], references: [id])

  userId             String?          @db.ObjectId
  user               User?            @relation("UserPayments", fields: [userId], references: [id])

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model IncidentReport {
  id                 String           @id @default(auto()) @map("_id") @db.ObjectId
  description        String
  medicationsGiven   String[]         @default([])
  patientCondition   String?
  
  // Relations
  requestId          String           @db.ObjectId @unique
  request            EmergencyRequest @relation(fields: [requestId], references: [id])
  
  reportedById       String           @db.ObjectId
  reportedBy         User             @relation("ReportedIncidents", fields: [reportedById], references: [id])

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}
